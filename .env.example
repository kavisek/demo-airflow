# Copy to .env, or let `make start` generate it with fresh values.
# .env is git-ignored. Never commit real keys.

# User ID the Airflow containers run as.
AIRFLOW_UID=50000

# Encrypts connection passwords and variables in the metadata database.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=<fernet-key>

# Signs API server sessions. Generate: openssl rand -hex 32
AIRFLOW_API_SECRET_KEY=<random-hex>

# Signs API JWTs. Generate: openssl rand -hex 32
AIRFLOW_JWT_SECRET=<random-hex>

# Optional host port overrides.
# AIRFLOW_API_PORT=8080
# POSTGRES_PORT=5432
